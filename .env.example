# /recommend 호출용 공유 비밀. 프론트 서버 환경 변수에 같은 값을 두고 X-API-Key 헤더로 보낸다.
# 비어 있으면 /recommend는 503이다. 예: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# IGDB — Twitch 개발자 콘솔(https://dev.twitch.tv/console)에서 앱을 등록해 받은 client credentials
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# SteamGridDB — https://www.steamgriddb.com/profile/preferences/api 에서 발급. 추천 카드의 로고·배너에 쓴다
STEAMGRIDDB_API_KEY=

# Steam 스토어 API, CheapShark(가격 폴백), PCGamingWiki(사양 폴백), Frankfurter(USD→KRW 환율)는
# 키가 필요 없다.

# OpenAI — 질문 가공, GPU·CPU 사양 판정, 리뷰 한줄평, 에이전트(도구 선택·최종 답변)에 쓴다.
# (질문 가공·리뷰 한줄평은 담당 모듈에서 gpt-4o-mini로 고정)
OPENAI_API_KEY=

# 모델은 기본값 gpt-4o-mini를 쓰려면 아래 줄을 주석인 채로 둔다.
# OPENAI_MODEL= 처럼 빈 값을 넣으면 기본값을 덮어써 모델명 없이 호출된다.
# OPENAI_MODEL=

# 에이전트(도구 선택·최종 답변) 모델. 지정하지 않으면 OPENAI_MODEL. 도구 선택이 흔들리면 이 값만 올린다
# OPENAI_AGENT_MODEL=

# LangSmith 추적(선택). 켜면 Tool 호출·프롬프트·토큰이 프로젝트별로 기록되어 프롬프트 개선 근거가 된다.
# https://smith.langchain.com 에서 키 발급. 키는 커밋하지 않는다(CI의 gitleaks가 검사한다)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=game-recommend-agent
