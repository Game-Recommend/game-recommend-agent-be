# /recommend 호출용 공유 비밀. 프론트 서버 환경 변수에 같은 값을 두고 X-API-Key 헤더로 보낸다.
# 비어 있으면 /recommend는 503이다. 예: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# IGDB — Twitch 개발자 콘솔(https://dev.twitch.tv/console)에서 앱을 등록해 받은 client credentials
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# SteamGridDB — https://www.steamgriddb.com/profile/preferences/api 에서 발급. 추천 카드의 로고·배너에 쓴다
STEAMGRIDDB_API_KEY=

# Steam 스토어 API, CheapShark(가격 폴백), PCGamingWiki(사양 폴백), Frankfurter(USD→KRW 환율)는
# 키가 필요 없다.

# OpenAI — 질문 가공, GPU·CPU 사양 판정, 리뷰 한줄평, 최종 답변에 쓴다. 모델은 비워 두면 gpt-4o-mini
# (질문 가공·리뷰 한줄평은 담당 모듈에서 gpt-4o-mini로 고정)
OPENAI_API_KEY=
OPENAI_MODEL=
